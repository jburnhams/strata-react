{
  "$schema": "https://typedoc.org/schema.json",
  "name": "strata-react API",
  "entryPoints": ["src/index.ts", "src/testing/index.tsx", "src/visual/index.ts"],
  "entryPointStrategy": "resolve",
  "tsconfig": "tsconfig.json",
  "out": "site/api",
  "readme": "README.md",
  "excludePrivate": true,
  "excludeInternal": true,
  "sort": ["kind", "alphabetical"],
  "navigationLinks": {
    "Storybook": "https://jburnhams.github.io/strata-react/",
    "Visual baselines": "https://jburnhams.github.io/strata-react/visuals/",
    "GitHub": "https://github.com/jburnhams/strata-react"
  },
  "validation": { "notExported": true, "invalidLink": true, "notDocumented": false }
}
