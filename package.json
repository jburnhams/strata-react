{
  "name": "strata-react",
  "version": "1.0.14",
  "description": "React + Tailwind v4 components that ship structure, behaviour, states and a token contract, and no look: each product brings a theme generated from its own subject.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jburnhams/strata-react.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./visual": {
      "types": "./dist/visual/index.d.ts",
      "import": "./dist/visual.js",
      "default": "./dist/visual.js"
    },
    "./strata.css": {
      "style": "./dist/strata.css",
      "default": "./dist/strata.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "UPGRADING.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && vite build && node scripts/copy-css.mjs",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "npm run build && vitest run --project integration",
    "test:all": "npm run test && npm run test:integration",
    "coverage": "vitest run --project unit --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet -o storybook-static",
    "test:visual": "npm run build && npm run build-storybook && npm run build-example && node bin/strata-visual.js",
    "test:visual:update": "npm run build && npm run build-storybook && npm run build-example && node bin/strata-visual.js --update",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test:all",
    "docs:api": "typedoc",
    "site": "npm run build-storybook && typedoc && node scripts/build-site.mjs",
    "build-example": "vite build --config examples/kiln-app/vite.config.ts --logLevel warn"
  },
  "keywords": [
    "react",
    "tailwindcss",
    "design-system",
    "components",
    "storybook",
    "visual-regression"
  ],
  "author": "jburnhams",
  "license": "MIT",
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@testing-library/react": "^16.0.0",
    "msw": "^2.7.0 || ^3.0.0",
    "playwright": ">=1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0 || ^8.0.0",
    "tailwindcss": "^4.1.0",
    "vite": ">=6.1.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    },
    "msw": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-stately": "^3.51.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-react-aria-components": "^2.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.4",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.5",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript7": "npm:typescript@~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  },
  "bin": {
    "strata-visual": "./bin/strata-visual.js"
  }
}
